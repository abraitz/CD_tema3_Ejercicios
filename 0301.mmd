classDiagram
        class Biblioteca {
        -libros: List~Libro~
        -socios: List~Socio~
        -prestamos: List~Prestamo~

        +altaSocio(socio: Socio): void
        +altaLibro(libro: Libro): void
        +registrarPrestamo(prestamo: Prestamo): void
    }

    class Libro {
        -titulo: String 
        -autor: String
        -isbn: String
        -anoPublicacion: int

        +getTitulo(): String
        +getAutor(): String
        +getIsbn(): String
        +getAnoPublicacion(): int
    }

    class Socio {
        -nombre: String
        -numeroSocio: String
        -fechaAlta: Date

        +getNombre(): String
        +getNumeroSocio(): String
        +getFechaAlta(): Date
    }


    class Prestamo {
        -socio: Socio
        -libro: Libro
        -fechaPrestamo: Date
        -fechaDevolucion: Date

        +getSocio(): Socio
        +getLibro(): Libro
        +getFechaPrestamo(): Date
        +getFechaDevolucion(): Date 

      }

        Prestamo "0..*" --> "1" Socio : asociacion
        Prestamo "0..1" --> "1" Libro : asociacion
        Biblioteca "1" o-- "0..*" Libro : agregacion
        Biblioteca "1" o-- "0..*" Socio : agregacion
        Biblioteca "1" *-- "0..*" Prestamo : Composicion
