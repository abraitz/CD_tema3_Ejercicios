classDiagram
   class Empresa {
    -nombre: String
    -departamentos: List~Departamento~

    +getEmpleadoSalarioMayor(): Empleado
   }

   class Departamento {
    -nombre: String
    -empleados: List~Empleado~

    +getSumEmpleadosSalarios(): double
   }

   class Empleado {
    -nombre: String
    -puesto: String
    -salario: double
   }

   Empresa "1" *-- "0..*" Departamento : composicion
   Departamento "1" o-- "0..*" Empleado : agregacion

